# ---- Base de datos (SQLite por defecto; Postgres al escalar) ----
DATABASE_URL=sqlite:///data/creative_intel.db
ASSETS_DIR=data/assets

# ---- IA: openai o anthropic ----
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CLASSIFY_MODEL=gpt-5.4-mini   # clasifica cada anuncio (barato, con visión)
OPENAI_SYNTH_MODEL=gpt-5.4           # escribe el plan creativo

# Ideas y guiones con Gemini (el análisis sigue con OpenAI). Clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CREATIVE_MODEL=gemini-3.1-pro-preview

# Alternativa: Anthropic (AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
CLASSIFY_MODEL=claude-sonnet-5-5
SYNTH_MODEL=claude-opus-5-5
# "default" activa fallbacks server-side ante rechazos de seguridad; vacío para desactivar
ANTHROPIC_FALLBACKS=default

# ---- Meta (Graph API) ----
# Token de usuario del sistema del Business Manager con permiso ads_read sobre las cuentas de los clientes.
# Con él, cada informe trae los resultados reales de los anuncios del cliente (meta_ad_account_id en su config).
# `radar check-meta` lista las cuentas a las que tiene acceso.
META_ACCESS_TOKEN=
# Instagram orgánico de la competencia (Business Discovery): el mismo token necesita además los permisos
# instagram_basic, pages_show_list y pages_read_engagement. Opcional: ID de la cuenta de Instagram profesional
# desde la que se consulta (vacío = la primera que tenga el token).
INSTAGRAM_BUSINESS_ID=
META_GRAPH_VERSION=v21.0

# ---- Google Ads Transparency Center vía SerpApi (opcional, recomendado) ----
SERPAPI_KEY=

# ---- Basecamp 3 ----
BASECAMP_ACCOUNT_ID=
BASECAMP_PROJECT_ID=
BASECAMP_VAULT_ID=
BASECAMP_TODOLIST_ID=
BASECAMP_ACCESS_TOKEN=
BASECAMP_REFRESH_TOKEN=
BASECAMP_CLIENT_ID=
BASECAMP_CLIENT_SECRET=
BASECAMP_USER_AGENT=creative-intel (hola@example.com)

# ---- Notificaciones para checkpoints humanos ----
SLACK_WEBHOOK_URL=
MAKE_WEBHOOK_URL=

# ---- API (para que Make dispare pasos) ----
API_TOKEN=cambiar-este-token


# Fuentes que usa `collect` / `run-cycle` cuando no se pasa --source
# (meta_web y google_web no necesitan claves; meta_api y google_serpapi sí)
COLLECT_SOURCES=meta_web,google_web,manual

# Cuánto se analiza y cuánto se gasta
TOP_ADS_PER_BRAND=5          # anuncios por marca y plataforma (Meta: los más vistos; Google: los primeros)
MAX_AI_USD_PER_RUN=2.00      # tope de gasto de IA por cliente y corrida; al llegar se frena y guarda lo hecho

# Contraseña de la web (`radar web --public` o --host 0.0.0.0 la exigen; mínimo 10 caracteres)
WEB_PASSWORD=
