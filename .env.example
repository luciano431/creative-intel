# ---- Base de datos (SQLite por defecto; Postgres al escalar) ----
DATABASE_URL=sqlite:///data/creative_intel.db
ASSETS_DIR=data/assets

# ---- IA (Anthropic) ----
ANTHROPIC_API_KEY=
CLASSIFY_MODEL=claude-opus-5-5
SYNTH_MODEL=claude-opus-5-5
# "default" activa fallbacks server-side ante rechazos de seguridad; vacío para desactivar
ANTHROPIC_FALLBACKS=default

# ---- Meta Ad Library (Graph API oficial) ----
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0

# ---- Google Ads Transparency Center vía SerpApi (opcional, recomendado) ----
SERPAPI_KEY=

# ---- Basecamp 3 ----
BASECAMP_ACCOUNT_ID=
BASECAMP_PROJECT_ID=
BASECAMP_VAULT_ID=
BASECAMP_TODOLIST_ID=
BASECAMP_ACCESS_TOKEN=
BASECAMP_REFRESH_TOKEN=
BASECAMP_CLIENT_ID=
BASECAMP_CLIENT_SECRET=
BASECAMP_USER_AGENT=creative-intel (hola@example.com)

# ---- Notificaciones para checkpoints humanos ----
SLACK_WEBHOOK_URL=
MAKE_WEBHOOK_URL=

# ---- API (para que Make dispare pasos) ----
API_TOKEN=cambiar-este-token
