{%- set C = brand.colors -%}
{%- set m = event_metrics -%}
{%- macro preview(it) -%}
  <div class="pv">
    {%- if it.thumbnail_rel -%}<img src="{{ it.thumbnail_rel }}" alt="Anuncio de {{ it.competitor }}">
    {%- else -%}<div class="pv-empty">Sin vista previa{% if it.snapshot_url %}<br><a href="{{ it.snapshot_url }}" target="_blank" rel="noopener">Ver en la biblioteca</a>{% endif %}</div>{%- endif -%}
    <span class="pv-tag {{ it.platform }}">{{ lbl(it.platform) }}</span>
  </div>
{%- endmacro -%}
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Guía de {{ event.name }} para {{ client.name }}</title>
{% if brand.font_url %}<link rel="stylesheet" href="{{ brand.font_url }}">{% endif %}
<style>
{% include "_style.css.j2" %}
  .phase { display: grid; grid-template-columns: 110px 1fr 48px; gap: 10px; align-items: center; margin: 6px 0; font-size: 14px; }
  .phase .track { background: var(--soft); border-radius: 6px; height: 14px; overflow: hidden; }
  .phase .fill { background: var(--accent); height: 100%; }
  .cal { display: grid; grid-template-columns: 140px 1fr; gap: 0; border-left: 3px solid var(--accent); margin-left: 6px; }
  .cal > div { padding: 10px 14px; border-bottom: 1px dashed var(--line); }
  .cal .when { font-weight: 700; }
</style>
</head>
<body>
<header class="cover">
  <div class="wrap">
    <div class="brandbar">
      <a class="logo" href="/" title="Volver al inicio del Radar creativo">{% if brand.logo_svg %}{{ brand.logo_svg | safe }}{% endif %}<span><span class="word">{{ brand.agency }}</span><span class="app">Radar creativo</span></span></a>
      <div class="meta">{{ client.industry }}{% if client.market %} · {{ client.market }}{% endif %}</div>
    </div>
    <p class="kicker">Modo evento</p>
    <h1>Guía de {{ event.name }} para <span>{{ client.name }}</span></h1>
    <p class="lead">{% if live %}Edición en curso: anuncios activos que arrancaron entre {{ edition.date_from }} y {{ edition.date_to }}{% else %}Basada en los anuncios de la edición {{ edition.label }}{% endif %}{% if m.event_start %} (evento: {{ m.event_start }}{% if m.event_end and m.event_end != m.event_start %} al {{ m.event_end }}{% endif %}{% if not m.official_dates %}, día de más anuncios{% endif %}){% endif %}</p>
    <div class="chips">
      {% if m.own_results %}<span class="chip">{{ m.own_results | length }} anuncios de {{ client.name }} con resultados</span>{% endif %}
      <span class="chip">{{ m.ads }} anuncios de la competencia</span>
      {% if next_dates.start %}<span class="chip">Próxima edición: {{ next_dates.start }}</span>{% else %}<span class="chip warn">Fecha de la próxima edición sin confirmar</span>{% endif %}
      <span class="chip">Generado {{ generated_at }}</span>
    </div>
  </div>
</header>
<main class="wrap">
{% set cur = m.currency or 'US$' %}
{% set dc = m.data_coverage %}
{% if dc %}
<section><div class="card" style="border-left:4px solid {{ {'alta':'#2F7D4F','media':'#B7791F','baja':'#9B2F25'}[dc.level] }}">
  <b>Con qué datos se armó esta guía · confianza {{ dc.level }}</b>
  <ul class="small" style="margin:6px 0 0;padding-left:18px;list-style:none">
    {% for r in dc.rows %}<li>{{ '✓' if r.ok else '✗' }} <b>{{ r.source }}:</b> {{ r.detail }}</li>{% endfor %}
  </ul>
  {% if m.sample and m.sample.sent < m.sample.total %}<p class="small muted" style="margin:6px 0 0">La IA vio {{ m.sample.sent }} de {{ m.sample.total }} anuncios, repartidos entre marcas y entre los más viejos y los más nuevos.</p>{% endif %}
  {% if dc.errors %}<details class="small" style="margin-top:6px"><summary>Errores al traer datos ({{ dc.errors | length }})</summary><ul style="margin:4px 0 0;padding-left:18px">{% for e in dc.errors[:8] %}<li>{{ e[:300] }}</li>{% endfor %}</ul></details>{% endif %}
</div></section>
{% elif m.collect_errors %}
<section><div class="card" style="border-left:4px solid #B7791F"><b>Lo que no se pudo traer en esta corrida</b>
  <ul class="small" style="margin:6px 0 0;padding-left:18px">{% for e in m.collect_errors[:8] %}<li>{{ e[:300] }}</li>{% endfor %}</ul></div></section>
{% endif %}
{% if not m.ads and not m.own_ads and not (m.own_daily or {}).phases and not m.organic %}
<section><div class="card">No se encontraron anuncios de esta edición. Revisá las fechas y palabras del evento en events.yaml.</div></section>
{% else %}
{% set od = m.own_daily or {} %}
{% if od.phases or m.own_groups %}
<section>
  <div class="sec-head"><span class="sec-num">01</span><h2>Lo que le funcionó a {{ client.name }}{% if m.event_only %} en los días del evento{% elif m.previa %} en el evento y su previa{% endif %}</h2></div>
  <p class="sec-intro">Datos reales de la cuenta publicitaria de {{ client.name }} en Meta, del {{ edition.date_from }} al {{ edition.date_to }}. Cada tipo de resultado va por separado: compras, conversaciones (WhatsApp / Messenger), leads y clics al sitio no se suman entre sí.</p>
  {% if od.phases %}
  <h3 style="margin:8px 0 6px">Antes, durante y después del evento</h3>
  <div class="tbl"><table>
    <thead><tr><th>Momento</th><th>Días</th><th>Inversión por día</th>{% for t in od.types %}<th>{{ t | capitalize }} por día</th><th>Costo por {{ {'compras':'compra','conversaciones':'conversación','leads':'lead','clics al sitio':'clic'}[t] }}</th>{% endfor %}</tr></thead>
    <tbody>
    {% for key, name in [('antes','Antes'),('durante','Durante el evento'),('despues','Después'),('sin_fechas','Ventana completa')] %}{% set p = od.phases.get(key) %}{% if p %}
      <tr><td><b>{{ name }}</b></td><td>{{ p.days }}</td><td>{{ cur }} {{ '%.2f' % p.spend_per_day }}</td>{% for t in od.types %}{% set x = p.per_type[t] %}<td>{{ x.per_day }}</td><td>{{ (cur ~ ' %.2f' % x.cost) if x.cost else '—' }}</td>{% endfor %}</tr>
    {% endif %}{% endfor %}
    </tbody>
  </table></div>
  <p class="small muted">{{ od.note }}</p>
  {% endif %}
  {% for g in m.own_groups %}
  <h3 style="margin:22px 0 8px">{{ g.stage }} · medidos en {{ g.type }} <span class="small muted">(del menor costo por {{ g.unit }} al mayor)</span></h3>
  <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(240px,1fr))">
    {% for r in g.rows[:6] %}
    <div class="cr">
      <div class="pv" style="height:340px;aspect-ratio:auto">{% if r.thumbnail_rel %}<img src="{{ r.thumbnail_rel }}" alt="{{ r.headline }}">{% else %}<div class="pv-empty">Sin vista previa</div>{% endif %}</div>
      <div class="cr-body">
        <div class="cr-top"><span class="tag">{{ lbl(r.format) }}</span>{% if loop.first and g.rows|length > 1 %}<span class="days">el mejor costo</span>{% endif %}</div>
        <h4>{{ r.headline[:70] or '(sin texto)' }}</h4>
        <div class="small muted">{% if r.product %}Producto: {{ r.product }}{% endif %}{% if r.offer %} · Oferta: {{ r.offer }}{% endif %}</div>
        <div style="margin-top:8px"><b style="font-size:18px">{{ (cur ~ ' %.2f' % r.cost_per_result) if r.cost_per_result else '—' }}</b> <span class="small muted">por {{ g.unit }}</span></div>
        <div style="height:6px;background:var(--line);border-radius:3px;margin:6px 0"><div style="height:6px;width:{{ r.bar }}%;background:{{ C.accent if C and C.accent else '#F26B38' }};border-radius:3px"></div></div>
        <div class="small">{{ '{:,}'.format(r.results|round(0)|int).replace(',', '.') }} {{ 'personas alcanzadas' if r.result_type == 'alcance' else r.result_type }} · {{ cur }} {{ '%.2f' % (r.spend or 0) }} invertidos · CTR {{ r.ctr }}%{% if r.roas %} · ROAS {{ r.roas }}{% endif %}</div>
      </div>
    </div>
    {% endfor %}
  </div>
  {% endfor %}
</section>
{% endif %}
<section>
  <div class="sec-head"><span class="sec-num">02</span><h2>Lo más importante</h2></div>
  <p class="sec-intro">Los hechos {{ 'de lo que está activo ahora' if live else 'de la edición anterior' }}, con sus números.</p>
  <div class="grid g3">
    {% for f in plan.summary %}<div class="card sum"><h3>{{ f.headline }}</h3><div>{{ f.detail }}</div></div>{% endfor %}
  </div>
</section>

{% if m.organic and not m.event_only %}
<section>
  <div class="sec-head"><span class="sec-num">IG</span><h2>Instagram en todo el período</h2></div>
  <p class="sec-intro">Contexto: todas las publicaciones (no anuncios) de cada cuenta entre {{ edition.date_from }} y {{ edition.date_to }}, sean o no del evento. Lo dedicado al evento va en la sección siguiente. Interacción = likes + comentarios; la tasa la divide por los seguidores para poder comparar cuentas de distinto tamaño.</p>
  <div class="tbl"><table>
    <thead><tr><th>Cuenta</th><th>Seguidores</th><th>Publicaciones</th><th>Nombraron el evento</th><th>Likes promedio</th><th>Comentarios promedio</th><th>Interacción / seguidores</th><th>Tipos</th></tr></thead>
    <tbody>
    {% for o in m.organic %}
      <tr><td><b>{{ o.brand }}</b>{% if o.own %} (cliente){% endif %}<br><span class="small muted">@{{ o.username }}</span></td><td>{{ '{:,}'.format(o.followers).replace(',', '.') if o.followers else '—' }}</td><td>{{ o.posts }}</td><td>{{ o.event_posts }}</td><td>{{ o.avg_likes }}</td><td>{{ o.avg_comments }}</td><td>{{ ('%.2f%%' % o.avg_rate) if o.avg_rate is not none else '—' }}</td><td class="small">{% for t, n in o.types.items() %}{{ t }} {{ n }}{% if not loop.last %} · {% endif %}{% endfor %}</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% set partial = m.organic | selectattr('source', 'equalto', 'perfil_publico') | list %}
  {% if partial %}<p class="small muted" style="margin-top:8px">De la competencia, Instagram deja ver sin permiso especial solo las últimas publicaciones{% for o in partial if o.visible_since %}{% if loop.first %} (ej. @{{ o.username }}: desde {{ o.visible_since }}){% endif %}{% endfor %}. Si una cuenta muestra 0, puede ser que publicó tanto después que esas fechas ya no se ven. Lo que el Radar archiva en cada corrida se suma acá.</p>{% endif %}
  {% set capped = m.organic | selectattr('capped') | list %}
  {% if capped %}<p class="small muted" style="margin-top:8px">{% for o in capped %}@{{ o.username }}{% if not loop.last %}, {% endif %}{% endfor %}: publica tanto que el tope por cuenta (APIFY_MAX_POSTS) no llegó al inicio de la ventana; lo de esas fechas puede estar incompleto.</p>{% endif %}
  {% for o in m.organic if o.top %}
  <h3 style="margin:22px 0 8px">Lo que más interacción tuvo de {{ o.brand }}</h3>
  <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr))">
    {% for p in o.top %}
    <div class="cr">
      <div class="pv" style="height:220px;aspect-ratio:auto">{% if p.image_rel %}<img src="{{ p.image_rel }}" alt="Publicación de {{ o.brand }}">{% else %}<div class="pv-empty">Sin vista previa</div>{% endif %}</div>
      <div class="cr-body">
        <div class="cr-top"><span class="tag">{{ p.timestamp[:10] }}</span>{% if p.names_event %}<span class="days">nombra el evento</span>{% endif %}</div>
        <div><b style="font-size:17px">{{ p.like_count if p.like_count is not none else '—' }}</b> <span class="small muted">likes</span> · <b style="font-size:17px">{{ p.comments_count or 0 }}</b> <span class="small muted">comentarios</span>{% if p.rate is not none %} · <span class="small">{{ p.rate }}% de los seguidores</span>{% endif %}</div>
        <div class="small">{{ (p.caption or '')[:160] }}{% if (p.caption or '')|length > 160 %}…{% endif %}</div>
        {% if p.permalink %}<a class="small" href="{{ p.permalink }}" target="_blank" rel="noopener">Ver publicación</a>{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% endfor %}
</section>
{% endif %}
{% set evorg = (m.organic or []) | selectattr('event') | list %}
{% if edition.start and (m.own_event_results or evorg) %}
<section>
  <div class="sec-head"><span class="sec-num">EV</span><h2>El evento en sí: {{ edition.start }}{% if edition.end and edition.end != edition.start %} al {{ edition.end }}{% endif %}</h2></div>
  <p class="sec-intro">Solo lo dedicado a {{ event.name }}: publicaciones que nombran la fecha o salieron en sus días, y los anuncios de {{ client.name }} con inversión en esos días (con los números de esos días).</p>
  {% if m.own_event_results %}
  <h3 style="margin:8px 0 6px">Pauta de {{ client.name }} en los días del evento</h3>
  <div class="tbl"><table>
    <thead><tr><th>Anuncio</th><th>Etapa</th><th>Inversión</th><th>Resultado</th><th>Costo</th></tr></thead>
    <tbody>{% for r in m.own_event_results %}
      <tr><td>{{ r.headline or 'Sin título' }}{% if r.names_event %} <span class="tag">nombra el evento</span>{% endif %}{% if r.offer %}<br><span class="small muted">{{ r.offer }}</span>{% endif %}</td>
        <td class="small">{{ (r.stage or '—') | upper }}</td><td>{{ cur }} {{ '%.2f' % (r.spend or 0) }}</td>
        <td>{{ '{:,}'.format((r.results or 0)|round(0)|int).replace(',', '.') }} {{ 'personas alcanzadas' if r.result_type == 'alcance' else (r.result_type or '') }}</td>
        <td>{{ (cur ~ ' %.2f' % r.cost_per_result) if r.cost_per_result else '—' }}</td></tr>
    {% endfor %}</tbody>
  </table></div>
  {% elif edition.start %}<p class="small muted">{{ client.name }} no tuvo anuncios con inversión en los días del evento.</p>{% endif %}
  {% if evorg %}
  {% set oe = m.organic_edition or {} %}
  <h3 style="margin:22px 0 6px">Publicaciones de Instagram del evento{% if oe.label and oe.label != edition.label %} · edición {{ oe.label }} ({{ oe['from'] }} al {{ oe['to'] }}){% endif %}</h3>
  {% if oe.label and oe.label != edition.label or oe.saved_only %}<p class="small muted" style="margin:0 0 6px">{% if oe.label and oe.label != edition.label %}El Instagram es de la edición {{ oe.label }}, la que ya está bajada. {% endif %}{% if oe.saved_only %}De la competencia se usó solo lo ya guardado (sin gastar Apify).{% endif %}</p>{% endif %}
  <div class="tbl"><table>
    <thead><tr><th>Cuenta</th><th>Publicaciones del evento</th><th>Nombran la fecha</th><th>Salieron en esos días</th><th>Interacción promedio</th>{% if not m.event_only %}<th>Contra su promedio del período</th>{% endif %}</tr></thead>
    <tbody>{% for o in evorg %}{% set e = o.event %}
      <tr><td><b>{{ o.brand }}</b>{% if o.own %} (cliente){% endif %}</td><td>{{ e.posts }}</td><td>{{ e.named }}</td><td>{{ e.in_days }}</td>
        <td>{% if o.capped and o.visible_since and o.visible_since > edition.date_to|string %}no se llegó a esas fechas{% else %}{{ e.avg_interactions if e.posts else ('no publicó' if m.event_only else '—') }}{% endif %}</td>
        {% if not m.event_only %}<td>{% if e.vs_period_pct is not none %}{{ '+' if e.vs_period_pct > 0 else '' }}{{ e.vs_period_pct }}%{% elif not e.posts %}no publicó sobre la fecha{% else %}—{% endif %}</td>{% endif %}</tr>
    {% endfor %}</tbody>
  </table></div>
  <p class="small muted" style="margin-top:6px">{% if m.event_only %}Interacción = likes + comentarios, por publicación. Interacción no es venta.{% else %}Interacción = likes + comentarios. "Contra su promedio" compara las publicaciones del evento con todas las de esa cuenta en el período: muestra si la fecha le movió la aguja a cada marca. Interacción no es venta.{% endif %}</p>
  {% for o in evorg if o.event.pieces %}
  <h3 style="margin:22px 0 8px">{{ o.brand }}: lo que publicó para el evento</h3>
  <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr))">
    {% for p in o.event.pieces %}
    <div class="cr">
      <div class="pv" style="height:220px;aspect-ratio:auto">{% if p.image_rel %}<img src="{{ p.image_rel }}" alt="Publicación de {{ o.brand }}">{% else %}<div class="pv-empty">Sin vista previa</div>{% endif %}</div>
      <div class="cr-body">
        <div class="cr-top"><span class="tag">{{ p.timestamp[:10] }}</span>{% if p.names_event %}<span class="days">nombra el evento</span>{% elif p.in_days %}<span class="days">en los días del evento</span>{% endif %}</div>
        <div><b style="font-size:17px">{{ p.like_count if p.like_count is not none else '—' }}</b> <span class="small muted">likes</span> · <b style="font-size:17px">{{ p.comments_count or 0 }}</b> <span class="small muted">comentarios</span></div>
        <div class="small">{{ (p.caption or '')[:160] }}{% if (p.caption or '')|length > 160 %}…{% endif %}</div>
        {% if p.permalink %}<a class="small" href="{{ p.permalink }}" target="_blank" rel="noopener">Ver publicación</a>{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% endfor %}
  {% endif %}
</section>
{% endif %}
{% if m.compare %}
{% set allc = [{'label': edition.label, 'from': edition.date_from|string, 'to': edition.date_to|string, 'own_paid': m.own_paid_total or {}}] + m.compare %}
{% set types = [] %}{% for c in allc %}{% for t in (c.own_paid.by_type or {}).keys() %}{% if t not in types %}{% set _ = types.append(t) %}{% endif %}{% endfor %}{% endfor %}
<section>
  <div class="sec-head"><span class="sec-num">VS</span><h2>{{ client.name }} contra sí mismo: cada edición</h2></div>
  <p class="sec-intro">La pauta de {{ client.name }} en los días de cada edición de {{ event.name }}. Así se ve qué se repite (y conviene volver a hacer) y qué fue de un solo año.</p>
  <h3 style="margin:8px 0 6px">Pauta de {{ client.name }}</h3>
  <div class="tbl"><table>
    <thead><tr><th>Edición</th><th>Días</th><th>Inversión</th>{% for t in types %}<th>{{ t | capitalize }}</th><th>Costo por {{ {'compras':'compra','conversaciones':'conversación','leads':'lead','clics al sitio':'clic'}.get(t, t) }}</th>{% endfor %}</tr></thead>
    <tbody>{% for c in allc %}{% set op = c.own_paid or {} %}
      <tr><td><b>{{ c.label }}</b>{% if loop.first %} <span class="muted small">(base de esta guía)</span>{% endif %}</td><td class="small">{{ c['from'] }} al {{ c['to'] }}</td>
        <td>{{ (cur ~ ' %.0f' % op.spend) if op.spend else '—' }}</td>
        {% for t in types %}{% set x = (op.by_type or {}).get(t) %}<td>{{ x.total if x else '—' }}</td><td>{{ (cur ~ ' %.2f' % x.cost) if x and x.cost else '—' }}</td>{% endfor %}</tr>
    {% endfor %}</tbody>
  </table></div>
  {% set own_org_base = (m.organic or []) | selectattr('own') | list | first %}
  <h3 style="margin:22px 0 8px">Nuestros anuncios, año contra año</h3>
  <div class="grid" style="grid-template-columns:repeat({{ allc | length }},minmax(0,1fr));align-items:start">
    {% for c in allc %}
    <div>
      <p class="small" style="margin:0 0 6px"><b>{{ c.label }}</b> · {{ c['from'] }} al {{ c['to'] }}</p>
      {% set ads = (m.own_results[:4] if loop.first else (c.own_paid.top or [])[:4]) %}
      {% for r in ads %}
      <div class="cr" style="margin-bottom:10px">
        {% set img = r.thumbnail_rel or r.image_rel %}
        <div class="pv" style="height:220px;aspect-ratio:auto">{% if img %}<img src="{{ img }}" alt="{{ r.headline or r.ad_name }}">{% else %}<div class="pv-empty">Sin vista previa</div>{% endif %}</div>
        <div class="cr-body small"><b>{{ r.headline or r.ad_name or 'Sin título' }}</b><br>{{ cur }} {{ '%.2f' % (r.spend or 0) }} · {{ (r.results or 0)|round(0)|int }} {{ r.result_type or '' }}{% if r.cost_per_result %} a {{ cur }} {{ '%.2f' % r.cost_per_result }}{% endif %}{% if r.ctr is not none %} · CTR {{ r.ctr }}%{% endif %}</div>
      </div>
      {% else %}<p class="small muted">Sin anuncios con inversión en esos días.</p>{% endfor %}
    </div>
    {% endfor %}
  </div>
  <h3 style="margin:22px 0 8px">Nuestro Instagram, año contra año</h3>
  <div class="grid" style="grid-template-columns:repeat({{ allc | length }},minmax(0,1fr));align-items:start">
    {% for c in allc %}{% set o = own_org_base if loop.first else c.own_organic %}
    <div>
      <p class="small" style="margin:0 0 6px"><b>{{ c.label }}</b>{% if loop.first and (m.organic_edition or {}).label and m.organic_edition.label != edition.label %} (Instagram de {{ m.organic_edition.label }}){% endif %}{% if o %} · {{ o.posts }} publicaciones, {{ o.avg_likes }} likes y {{ o.avg_comments }} comentarios en promedio{% endif %}</p>
      {% for q in (o.top if o else [])[:3] %}
      <div class="cr" style="margin-bottom:10px">
        <div class="pv" style="height:220px;aspect-ratio:auto">{% if q.image_rel %}<img src="{{ q.image_rel }}" alt="Publicación de {{ client.name }}">{% else %}<div class="pv-empty">Sin vista previa</div>{% endif %}</div>
        <div class="cr-body small"><span class="tag">{{ q.timestamp[:10] }}</span> {{ q.like_count if q.like_count is not none else '—' }} likes · {{ q.comments_count or 0 }} comentarios<br>{{ (q.caption or '')[:110] }}{% if (q.caption or '')|length > 110 %}…{% endif %}</div>
      </div>
      {% else %}<p class="small muted">Sin publicaciones en esos días.</p>{% endfor %}
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}
{% set ms = m.market_search or {} %}
{% if not m.ads %}
<section>
  <div class="sec-head"><span class="sec-num">03</span><h2>La competencia en esas fechas</h2></div>
  <div class="card">
    <p>No se encontró ningún anuncio de la competencia {{ 'activo' if live else 'que se haya mostrado en esas fechas' }}.{% if not live %} Meta no guarda los anuncios terminados fuera de Europa; Google sí, pero para Uruguay solo dice el último día en que se mostró cada anuncio.{% endif %}</p>
    {% if ms %}<div class="tbl"><table><thead><tr><th>Marca</th><th>Anuncios revisados en Google</th><th>Mostrados en esas fechas</th></tr></thead><tbody>
    {% for slug, st in ms.items() %}<tr><td>{{ st.name }}</td><td>{{ st.checked }}{% if st.declared %} de ~{{ st.declared }}{% endif %}</td><td>{{ st.found }}</td></tr>{% endfor %}
    </tbody></table></div>{% endif %}
    <p class="small muted">Para la próxima edición: corré el modo en vivo (--live) en los días previos y durante el evento; el Radar guarda su propio archivo de lo que hace la competencia.</p>
  </div>
</section>
{% else %}
{% if live and not m.official_dates %}
<section>
  <div class="sec-head"><span class="sec-num">03</span><h2>Cuándo arrancó la competencia</h2></div>
  <div class="card">Todavía no está cargada la fecha de esta edición. Cuando se confirme, cargala en <code>events.yaml</code> (next: start/end) y esta sección muestra cuántos días antes arranca cada marca.</div>
</section>
{% else %}
<section>
  <div class="sec-head"><span class="sec-num">03</span><h2>Cuándo arrancó la competencia</h2></div>
  <p class="sec-intro">Anuncios según cuándo empezaron a circular respecto del día del evento. El primero arrancó {{ m.timing.earliest_days_before }} días antes.</p>
  <div class="card">
    {% set tot = m.ads or 1 %}
    {% for key, label in [('anticipo', 'Más de 7 días antes'), ('previa', '1 a 7 días antes'), ('durante', 'Durante'), ('despues', 'Después (extensión)')] %}
    {% set v = m.timing.phases[key] %}
    <div class="phase"><span>{{ label }}</span><div class="track"><div class="fill" style="width:{{ (100 * v / tot) | round | int }}%"></div></div><b>{{ v }}</b></div>
    {% endfor %}
  </div>
</section>
{% endif %}

<section>
  <div class="sec-head"><span class="sec-num">04</span><h2>Ofertas y urgencia de la competencia</h2></div>
  <div class="grid g2">
    <div class="card">
      <h3>Qué ofrecieron</h3>
      <table><tbody>
      {% for d in m.offers.dist %}<tr><td>{{ d.value | replace('_', ' ') | capitalize }}</td><td style="text-align:right">{{ d.count }} de {{ m.ads }}</td></tr>{% else %}<tr><td class="muted">Sin ofertas detectadas en el texto.</td></tr>{% endfor %}
      </tbody></table>
      {% if m.offers.with_pct %}<p class="small muted">Descuento: {{ m.offers.with_pct }} anuncios dicen un %; el más común ronda {{ m.offers.pct_median }}% y el máximo {{ m.offers.pct_max }}%.{% if m.offers.cuotas_max %} Cuotas: hasta {{ m.offers.cuotas_max }}.{% endif %}</p>{% endif %}
    </div>
    <div class="card">
      <h3>Urgencia</h3>
      <table><tbody>
      {% for d in m.urgency %}<tr><td>{{ d.value | capitalize }}</td><td style="text-align:right">{{ d.count }} de {{ m.ads }}</td></tr>{% else %}<tr><td class="muted">Sin mensajes de urgencia.</td></tr>{% endfor %}
      </tbody></table>
      <h3 style="margin-top:14px">Formatos</h3>
      <p class="small">{% for d in m.formats %}{{ lbl(d.value) }} {{ d.count }}{% if not loop.last %} · {% endif %}{% endfor %}</p>
      {% if m.duration_median is not none %}<p class="small muted">Los anuncios ya finalizados duraron {{ m.duration_median }} días (mediana).</p>{% endif %}
    </div>
  </div>
  <div class="card" style="margin-top:16px">
    <h3>Quién pautó</h3>
    <p class="small">{% for a in m.advertisers %}<b>{{ a.name }}</b> {{ a.ads }}{% if a.own %} (cliente){% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</p>
  </div>
</section>
{% endif %}

{% if refs %}
<section>
  <div class="sec-head"><span class="sec-num">05</span><h2>Anuncios de referencia de la competencia</h2></div>
  <p class="sec-intro">Los de la edición anterior con más señales (más días al aire, más versiones). Para inspirarse, no para copiar.</p>
  <div class="grid g3">
    {% for it in refs %}
    <div class="cr">{{ preview(it) }}<div class="cr-body"><div class="cr-top"><span class="tag">{{ lbl(it.format) }}</span><span class="days">{{ it.signals | join(' · ') }}</span></div><h4>{{ it.competitor }}</h4>{% if it.cls and it.cls.product_shown %}<div class="small muted">Producto: {{ it.cls.product_shown }}</div>{% endif %}{% if it.headline %}<div class="hl">“{{ it.headline[:120] }}”</div>{% endif %}{% if it.snapshot_url %}<a class="small" href="{{ it.snapshot_url }}" target="_blank" rel="noopener">Ver anuncio original</a>{% endif %}</div></div>
    {% endfor %}
  </div>
</section>
{% endif %}

<section>
  <div class="sec-head"><span class="sec-num">{{ '06' if m.ads else '04' }}</span><h2>Plan para {{ client.name }}</h2></div>
  <div class="card" style="margin-bottom:16px"><h3>Oferta a comunicar</h3>{{ plan.offer_recommendation | chain }}</div>
  <h3>Calendario de piezas</h3>
  <div class="cal">
    {% for c in plan.calendar %}<div class="when">{{ c.when }}</div><div><b>{{ c.goal | capitalize }}</b> · {{ c.format }} — {% if c.message %}«{{ c.message }}» <span class="muted">({{ c.cta }})</span>{% else %}<span class="muted">{{ c.intent }}</span>{% endif %}</div>{% endfor %}
  </div>
  {% if plan.creative_error %}<div class="card" style="margin-top:16px;border-left:4px solid #9B2F25"><b>Las piezas no se escribieron:</b> Gemini falló ({{ plan.creative_error }}). Abajo quedan los briefs del análisis; generá la guía de nuevo cuando Gemini ande.</div>{% endif %}
  {% if plan.ideas %}
  <h3 style="margin-top:24px">{{ 'Ideas listas para producir' if not plan.creative_error else 'Briefs de las piezas' }}</h3>
  <div class="grid g2">
    {% for c in plan.ideas %}
    <div class="card idea">
      <h4 style="margin:0 0 6px">{{ c.title }}</h4>
      <p class="small muted" style="margin:0 0 8px">{% if c.moment %}{{ c.moment }} · {% endif %}{{ c.format }}{% if c.product %} · {{ c.product }}{% endif %} · {{ lbl(c.angle) }}</p>
      {% if c.brief and not c.script %}<p><b>Brief:</b> {{ c.brief }}</p>{% endif %}
      {% if c.hook_line %}<div class="idea-hook"><span class="k">Primeros 3 segundos</span>«{{ c.hook_line }}»</div>{% endif %}
      {% if c.script %}<div class="k" style="margin:10px 0 4px">Guion</div><ol class="script">{% for b in c.script %}<li>{{ b }}</li>{% endfor %}</ol>{% endif %}
      {% if c.copy_draft %}<p><b>Copy:</b> {{ c.copy_draft }}</p>{% endif %}
      {% if c.cta or c.visual_direction %}<p class="small"><b>CTA:</b> {{ c.cta }} · <b>Visual:</b> {{ c.visual_direction }}</p>{% endif %}
      {% if c.evidence %}<dl class="small chain" style="margin:10px 0 0;border-top:1px solid var(--line, #ddd);padding-top:8px">
        <dt><b>Dato</b></dt><dd style="margin:0 0 4px">{{ c.evidence | nolabel }}</dd>
        <dt><b>Lectura</b></dt><dd style="margin:0 0 4px">{{ c.reading | nolabel }}</dd>
        <dt><b>Hipótesis</b></dt><dd style="margin:0 0 4px">{{ c.hypothesis | nolabel }}</dd>
        <dt><b>Cómo se prueba</b></dt><dd style="margin:0">{{ c.test | nolabel }}</dd>
      </dl>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% if plan.avoid %}<div class="card" style="margin-top:16px"><h3>Qué no hacer</h3><ul>{% for a in plan.avoid %}<li>{{ a }}</li>{% endfor %}</ul></div>{% endif %}
</section>
{% endif %}
<section><p class="small muted">Fuentes: Biblioteca de anuncios de Meta{% if not live %} y Centro de transparencia de Google (anuncios que se mostraron entre {{ edition.date_from }} y {{ edition.date_to }}){% endif %}, de las marcas configuradas y de quien mencionó {{ event.keywords | join(', ') }}; resultados de {{ client.name }}: su cuenta publicitaria de Meta. Las cifras del mercado cuentan anuncios, no inversión.{% if plan.ideas_by %} Análisis: GPT. Piezas, guiones y textos del calendario: {{ plan.ideas_by }}.{% endif %}</p></section>
</main>
</body>
</html>
