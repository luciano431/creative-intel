{% extends "base.html.j2" %}
{% block title %}Eventos{% endblock %}
{% block main %}
<h1>Guías de fechas especiales</h1>
<p class="muted" style="margin:0 0 20px">Elegí la fecha, la edición y los clientes: el Radar arma una guía por cliente con sus resultados reales, lo que hizo la competencia y el plan de piezas.</p>

<div class="card" style="margin-bottom:20px">
  <div class="fields">
    <div class="field">
      <label for="ev">Fecha especial</label>
      <select id="ev">
        {% for e in events %}<option value="{{ e.key }}">{{ e.name }}{% if e.days is not none and e.days >= 0 %} · faltan {{ e.days }} días{% elif not e.next %} · próxima sin confirmar{% endif %}</option>{% endfor %}
      </select>
    </div>
    <div class="field">
      <label for="ed">Edición</label>
      <select id="ed">
        {% for e in events %}
        {% for x in e.editions %}<option value="{{ x.label }}" data-ev="{{ e.key }}">Guía basada en la edición {{ x.label }}{% if x.start %} ({{ x.start }}{% if x.end and x.end != x.start %} al {{ x.end }}{% endif %}){% endif %}</option>{% endfor %}
        <option value="vivo" data-ev="{{ e.key }}">Solo archivar lo que la competencia tiene activo hoy (no es la guía)</option>
        {% endfor %}
      </select>
    </div>
  </div>
  <p class="small muted" id="ed-help" style="margin:0 0 12px"></p>

  <label>Clientes</label>
  <div class="row" style="margin-bottom:12px">
    {% for c in clients %}<label class="check"><input type="checkbox" class="cl" value="{{ c.key }}" checked> {{ c.name }}</label>{% endfor %}
  </div>
  <label class="check" style="margin-bottom:4px"><input type="checkbox" id="ai" checked> Con IA (resumen, oferta, calendario e ideas con guion · ≈ US$ 0,30 por cliente)</label>
  <p class="small muted" id="ai-help" style="margin:0 0 14px"></p>
  <div class="row">
    <button class="btn" id="go" {% if running %}disabled{% endif %}>Generar guías</button>
    <span class="small muted">Corre un cliente tras otro; puede tardar varios minutos por cliente.</span>
  </div>
  <div class="err" id="err"></div>
</div>

<div id="jobs" {% if not jobs %}style="display:none"{% endif %}>
  <h2>Guías en proceso</h2>
  <div id="job-list">
    {% for j in jobs %}
    <div class="job card" data-id="{{ j.id }}" data-status="{{ j.status }}" style="margin-top:12px"></div>
    {% endfor %}
  </div>
</div>

<h2 style="margin-top:28px">Guías ya generadas</h2>
<div class="grid">
  {% for c in clients %}{% set reps = reports[c.key] %}
  <div class="card">
    <h3>{{ c.name }}</h3>
    {% if reps %}<ul class="small" style="margin:0;padding-left:18px">{% for r in reps[:12] %}<li><a href="{{ r.url }}" target="_blank" rel="noopener">{{ r.name }}</a> <span class="muted">· {{ r.updated }}</span> · <button class="del" data-c="{{ c.key }}" data-n="{{ r.name }}" style="border:0;background:none;color:#9B2F25;cursor:pointer;font:inherit;padding:0">borrar</button></li>{% endfor %}</ul>
    {% else %}<p class="small muted" style="margin:0">Todavía ninguna.</p>{% endif %}
  </div>
  {% endfor %}
</div>
{% endblock %}

{% block scripts %}
<script>
const $ = id => document.getElementById(id);
const JOBS = {{ jobs | tojson }};
const HELP = {
  vivo: 'Solo guarda los anuncios que la competencia tiene activos hoy (sin IA, gratis). Usalo cada 2 o 3 días antes y durante la fecha: así el año que viene la guía tiene contra qué comparar. No genera la guía.',
  past: 'La guía: resultados reales del cliente en esa edición (Meta), lo que hizo la competencia en esas fechas y el plan de piezas con ideas.'
};
function syncEd() {
  const ev = $('ev').value; let first = null;
  [...$('ed').options].forEach(o => { o.hidden = o.dataset.ev !== ev; if (!o.hidden && !first) first = o; });
  if (!$('ed').selectedOptions[0] || $('ed').selectedOptions[0].hidden) first.selected = true;
  const vivo = $('ed').value === 'vivo';
  $('ed-help').textContent = vivo ? HELP.vivo : HELP.past;
  $('ai').disabled = vivo; if (vivo) $('ai').checked = false;
  $('ai-help').textContent = vivo ? '' : ($('ai').checked ? '' : 'Sin IA la guía trae solo los números: sin resumen, oferta ni ideas.');
  $('go').textContent = vivo ? 'Archivar ahora' : 'Generar guías';
}
$('ai').addEventListener('change', syncEd);
$('ev').addEventListener('change', syncEd); $('ed').addEventListener('change', syncEd); syncEd();

function addJob(j) {
  $('jobs').style.display = '';
  const el = document.createElement('div'); el.className = 'job card'; el.dataset.id = j.id; el.style.marginTop = '12px';
  el.innerHTML = JOB_HTML; $('job-list').prepend(el); paintJob(el, j); $('go').disabled = true;
}
document.querySelectorAll('.job').forEach(el => { const j = JOBS.find(x => x.id === el.dataset.id); el.innerHTML = JOB_HTML; if (j) paintJob(el, j); });
async function poll() {
  for (const el of document.querySelectorAll('.job')) {
    if (!['pendiente', 'corriendo'].includes(el.dataset.status)) continue;
    try { const j = await (await fetch('/api/tareas/' + el.dataset.id)).json(); paintJob(el, j);
          if (!['pendiente', 'corriendo'].includes(j.status)) $('go').disabled = false; } catch (e) {}
  }
}
setInterval(poll, 3000);
document.querySelectorAll('.del').forEach(b => b.addEventListener('click', async () => {
  if (b.dataset.armed !== '1') { b.dataset.armed = '1'; b.textContent = '¿seguro? clic de nuevo'; return; }
  try { await api('/api/c/' + b.dataset.c + '/borrar-guia', {name: b.dataset.n}); b.closest('li').remove(); }
  catch (e) { b.textContent = e.message; }
}));
$('go').addEventListener('click', async () => {
  $('err').textContent = '';
  const clients = [...document.querySelectorAll('.cl:checked')].map(x => x.value);
  try { addJob(await api('/api/eventos', {event: $('ev').value, edition: $('ed').value, clients, ai: $('ai').checked})); }
  catch (e) { $('err').textContent = e.message; }
});
</script>
{% endblock %}
